# ========================================
# 乐美车辆预约系统 - 环境变量配置示例
# ========================================
# 
# 使用说明：
# 1. 复制此文件为 .env（开发环境）或 .env.production（生产环境）
# 2. 填写实际的配置值
# 3. 不要将 .env 文件提交到 Git 仓库
#
# ========================================

# ========================================
# 数据库配置
# ========================================

# 数据库连接地址
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carbooking

# 数据库用户名和密码
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# 完整的 JDBC URL（可选，如果设置了会覆盖上面的配置）
# DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8

# ========================================
# Redis 配置
# ========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ========================================
# JWT 配置
# ========================================

# JWT 密钥（建议使用 32 位以上的随机字符串）
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# JWT 过期时间（分钟）
JWT_EXPIRE_TIME=300

# ========================================
# 微信企业号配置
# ========================================

# 企业 ID
WECHAT_CORP_ID=your-wechat-corp-id

# 企业应用密钥
WECHAT_CORP_SECRET=your-wechat-corp-secret

# 企业应用 ID
WECHAT_AGENT_ID=1000002

# ========================================
# Druid 监控配置
# ========================================

# Druid 监控控制台用户名和密码
DRUID_USERNAME=admin
DRUID_PASSWORD=your-druid-password

# ========================================
# ESB 配置
# ========================================

# ESB 服务器地址
ESB_IP=your-esb-server-ip
ESB_PORT=8020

# SAP 接口地址
SAP_API_URL=https://your-sap-api-url

# ========================================
# 应用配置
# ========================================

# 应用端口
SERVER_PORT_ADMIN=8066
SERVER_PORT_API=8601

# 应用环境（dev/test/prod）
SPRING_PROFILES_ACTIVE=dev



# ========================================
# 日志配置
# ========================================

# 日志级别（DEBUG/INFO/WARN/ERROR）
LOG_LEVEL=INFO

# 日志文件路径
LOG_PATH=./logs

# ========================================
# 其他配置
# ========================================

# 文件上传路径
UPLOAD_PATH=./uploads

# 文件上传大小限制（MB）
UPLOAD_MAX_SIZE=10
