<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vrs</groupId>
    <artifactId>vrs</artifactId>

    <version>3.7.0</version>



    <name>vrs</name>
    <description>VRS车辆预约管理系统</description>

    <!--版本控制-->
    <properties>
        <java.version>1.8</java.version>
        <vrs.version>3.7.0</vrs.version>
        <!--设置utf-8-->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--设置项目编码 为UTF-8 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven-jar-plugin.version>3.1.1</maven-jar-plugin.version>
        <!--阿里连接数据池-->
        <druid.version>1.2.8</druid.version>
        <!--解析客户端操作。浏览器操作-->
        <bitwalker.version>1.21</bitwalker.version>
        <!--swagger 依赖版本-->
        <swagger.version>3.0.0</swagger.version>
        <!--验证码版本-->
        <kaptcha.version>2.3.2</kaptcha.version>
        <!--mybatis集成版本-->
        <mybatis-spring-boot.version>2.2.0</mybatis-spring-boot.version>
        <!--分页插件-->
        <pagehelper.boot.version>1.4.1</pagehelper.boot.version>
        <!--阿里json-->
        <fastjson.version>1.2.78</fastjson.version>
        <!--获取系统信息版本-->
        <oshi.version>5.8.2</oshi.version>
        <!--jna版本-->
        <jna.version>5.9.0</jna.version>
        <!--io常用处理版本-->
        <commons.io.version>2.11.0</commons.io.version>
        <!--io上传文件版本-->
        <commons.fileupload.version>1.4</commons.fileupload.version>
        <commons.collections.version>3.2.2</commons.collections.version>
        <!--excel工具版本-->
        <poi.version>4.1.2</poi.version>

        <velocity.version>1.7</velocity.version>

        <!--jwt依赖-->
        <jwt.version>0.9.1</jwt.version>
    </properties>
    <!--依赖声明-->
    <!--已下依赖-->
    <dependencyManagement>
        <dependencies>



            <!-- SpringBoot的依赖配置-->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>2.5.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--阿里数据池连接-->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!--解析客户端操作，浏览器等-->
            <dependency>
                <groupId>eu.bitwalker</groupId>
                <artifactId>UserAgentUtils</artifactId>
                <version>${bitwalker.version}</version>
            </dependency>

            <!--spring boot 集合mybatis 框架-->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!--分页插件 pagehelper-->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.boot.version}</version>
            </dependency>

            <!--获取系统信息-->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>

            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>

            <!--Swagger3 依赖-->
            <!-- Swagger3依赖 -->
            <dependency>
                <groupId>io.springfox</groupId>
                <artifactId>springfox-boot-starter</artifactId>
                <version>${swagger.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.swagger</groupId>
                        <artifactId>swagger-models</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- io  常用工具类-->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons.io.version}</version>
            </dependency>

            <!--文件上传工具类-->
            <dependency>
                <groupId>commons-fileupload</groupId>
                <artifactId>commons-fileupload</artifactId>
                <version>${commons.fileupload.version}</version>
            </dependency>

            <!--excel 工具-->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!--velocity 代码生产使用模板-->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity</artifactId>
                <version>${velocity.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>commons-collections</groupId>
                        <artifactId>commons-collections</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!--collections工具类 跟集合操作工具类 -->
            <dependency>
                <groupId>commons-collections</groupId>
                <artifactId>commons-collections</artifactId>
                <version>${commons.collections.version}</version>
            </dependency>

            <!--阿里json解析-->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson.version}</version>
            </dependency>

            <!--Token 生成于解析-->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <!--验证码-->
            <dependency>
                <groupId>com.github.penggle</groupId>
                <artifactId>kaptcha</artifactId>
                <version>${kaptcha.version}</version>
            </dependency>

            <!-- 定时任务-->
<!--            <dependency>-->
<!--                <groupId>com.lemei</groupId>-->
<!--                <artifactId>moban-quartz</artifactId>-->
<!--                <version>${lemei.version}</version>-->
<!--            </dependency>-->

            <!-- 代码生成-->
            <dependency>
                <groupId>com.vrs</groupId>
                <artifactId>vrs-generator</artifactId>
                <version>${vrs.version}</version>
            </dependency>

            <!-- 通用工具-->
            <dependency>
                <groupId>com.vrs</groupId>
                <artifactId>vrs-common</artifactId>
                <version>${vrs.version}</version>
            </dependency>
            <!--定时任务-->

            <!-- 核心模块-->
            <dependency>
                <groupId>com.vrs</groupId>
                <artifactId>vrs-framework</artifactId>
                <version>${vrs.version}</version>
            </dependency>

            <!-- 系统模块-->
            <dependency>
                <groupId>com.vrs</groupId>
                <artifactId>vrs-system</artifactId>
                <version>${vrs.version}</version>
            </dependency>

            <!-- 系统模块-->
            <dependency>
                <groupId>com.vrs</groupId>
                <artifactId>vrs-quartz</artifactId>
                <version>${vrs.version}</version>
            </dependency>

            <!-- 通用工具-->
<!--            <dependency>-->
<!--                <groupId>com.lemei</groupId>-->
<!--                <artifactId>lemei-common</artifactId>-->
<!--                <version>${lemei.version}</version>-->
<!--            </dependency>-->


        </dependencies>
    </dependencyManagement>
    <modules>

        <module>vrs-admin</module>
        <module>vrs-common</module>
        <module>vrs-framework</module>
        <module>vrs-system</module>
        <module>vrs-generator</module>
        <module>vrs-api</module>
        <module>vrs-quartz</module>
        <!--加入自己的代码-->
    </modules>
    <packaging>pom</packaging>

    <dependencies>

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <!-- 默认跳过测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.12.4</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Maven Profiles：分离打包和测试 -->
    <profiles>
        <!-- 默认profile：跳过测试，用于快速打包 -->
        <profile>
            <id>package-only</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>2.12.4</version>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!-- 测试profile：执行测试 -->
        <profile>
            <id>with-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>2.12.4</version>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
