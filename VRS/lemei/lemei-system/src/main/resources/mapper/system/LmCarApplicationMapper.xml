    <select id="selectSaleList" parameterType="com.lemei.system.domain.param.CarSaleQueryParam" resultMap="SaleResult">
        <include refid="selectSaleVo"/>
<!--        <where>-->
<!--&lt;!&ndash;            <if test="lmDnnum != null "> and lm_dnnum = #{lmDnnum}</if>&ndash;&gt;-->
<!--&lt;!&ndash;            <if test="lmPackagingid != null "> and lm_packagingid = #{lmPackagingid}</if>&ndash;&gt;-->
<!--            <if test="queryCondition != null  and queryCondition != ''">-->
<!--                and (-->
<!--                lm_car_number like concat('%', #{queryCondition}, '%')-->
<!--                or lm_dnnum like concat('%', #{queryCondition}, '%')-->
<!--                or lm_packagingid like concat('%', #{queryCondition}, '%')-->
<!--                or lm_order_id like concat('%', #{queryCondition}, '%')-->
<!--                )-->
<!--            </if>-->
<!--        </where>-->
        <where>
            <!-- 动态条件：根据 queryCondition 是否为空，选择不同的过滤逻辑 -->
            <choose>
                <when test="queryCondition != null and queryCondition != ''">
                    <!-- 模糊查询：当 queryCondition 存在时，搜索多个字段 -->
                    AND MATCH (
                    lm_car_number, lm_dnnum, lm_packagingid, lm_order_id
                    ) AGAINST (
                    CONCAT('"', #{queryCondition}, '"') IN BOOLEAN MODE
                    )
                </when>
                <otherwise>
                    <!-- 日期过滤：当 queryCondition 为空时，筛选最近两天的数据 -->
                    AND lm_loadTime >= #{yesterday}
                </otherwise>
            </choose>
        </where>
        ORDER BY lm_actualdeliverydate,lm_dnnum,lm_dnline ASC
    </select>

