    <!-- 根据 lmIds 查询对应的 lm_dnnum 和 lm_dnline -->
    <select id="selectDnNumLineByLmIds" resultType="map">
        SELECT lm_dnnum, lm_dnline
        FROM lm_sale_item_real
        WHERE lm_Id IN
        <foreach item="lmId" index="index" collection="array" open="(" separator="," close=")">
            #{lmId}
        </foreach>
    </select>

    <!-- 根据 lm_dnnum 和 lm_dnline 删除记录 -->
    <delete id="deleteByDnNumLinePairsReal">
        DELETE FROM lm_sale_item_real
        WHERE (lm_dnnum, lm_dnline) IN
        <foreach item="pair" index="index" collection="list" open="(" separator="," close=")">
            (#{pair.lm_dnnum}, #{pair.lm_dnline})
        </foreach>
    </delete>

    <!-- 根据 lm_dnnum 和 lm_dnline 删除记录 -->
    <delete id="deleteByDnNumLinePairsInsert">
        DELETE FROM lm_sale_item_insert
        WHERE (lm_dnnum, lm_dnline) IN
        <foreach item="pair" index="index" collection="list" open="(" separator="," close=")">
            (#{pair.lm_dnnum}, #{pair.lm_dnline})
        </foreach>
    </delete>

</mapper>