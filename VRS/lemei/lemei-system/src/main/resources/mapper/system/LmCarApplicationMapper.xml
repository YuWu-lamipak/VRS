    <sql id="selectLmCarApplicationVo">
        select application_id, driver_name, car_number, driver_id, phone, IDCard,
               date_format(application_date,'%Y-%m-%d %H:%m:%s') application_date, out_date, enter_date, created_date, created_by,
               created_name, isDeleted, enter_status, status, carrier_id, carrier_name,
               ifnull(before_weight,0) before_weight, remark, reason, reason_key, scrap, scrap_key, post_type,
               checker_id, checker_name,application_no,order_id,businessType,businessDescription,supplyCode,supplyName,
               custCode,custName,documentCode,dataAreaId,factoryCode,taskID,appointmentWeight,loseWeight,shippedWithPalletWeight,floatReason,cardID,
               cardType,createCardTime,returnCardTime,appointmentStatus,firstWeight,firstWeightTime,
               loadoMeterID1,userID1,userName1,secondWeight,truckWeight,netWeight,packWeight,goodsWeight,
               enableControl,round(toleranceAdd * 100, 2) AS toleranceAdd,round(toleranceDec * 100, 2) AS toleranceDec,upFloatingWeight,downFloatingWeight,secondWeightTime,loadoMeterID2,userID2,userName2,truckNo2,atmsId,isUpdate,userId,userName,loadoMeterID,truckType,serialNumber,factoryType,wMSPickingRouteIDs,wMSPickingRouteIDs2,mark
        from lm_car_application
    </sql>

    <select id="selectLmCarApplicationList" parameterType="com.lemei.system.domain.param.CarApplicationQueryParam" resultMap="LmCarApplicationResult">
        <include refid="selectLmCarApplicationVo"/>
        <where>
            isDeleted = 0
<!--            <if test="applicationDate != null ">-->
<!--                and application_date >= date_format(#{applicationDate},'%Y-%m-%d 00:00:00')-->
<!--                and date_format(#{applicationDate},'%Y-%m-%d 23:59:59') >= application_date-->
<!--            </if>-->
            <!-- 修改 applicationDate 为 startTime 和 endTime 的范围查询 -->
            <if test="startTime != null and endTime != null">
                and application_date >= date_format(#{startTime},'%Y-%m-%d 00:00:00')
                and date_format(#{endTime},'%Y-%m-%d 23:59:59') >= application_date
            </if>
            <!-- 如果只传了 startTime，查询从 startTime 开始之后的数据 -->
            <if test="startTime != null and endTime == null">
                and application_date >= date_format(#{startTime},'%Y-%m-%d 00:00:00')
            </if>
            <!-- 如果只传了 endTime，查询到 endTime 为止的数据 -->
            <if test="endTime != null and startTime == null">
                and date_format(#{endTime},'%Y-%m-%d 23:59:59') >= application_date
            </if>
            <!-- 如果只传了 applicationDate，查询 applicationDate 的数据 -->
            <if test="startTime == null and endTime == null and applicationDate != null">
                and application_date >= date_format(#{applicationDate},'%Y-%m-%d 00:00:00')
                and date_format(#{applicationDate},'%Y-%m-%d 23:59:59') >= application_date
            </if>

             <if test="createdDate != null ">
                and created_date >= date_format(#{createdDate},'%Y-%m-%d 00:00:00')
                and date_format(#{createdDate},'%Y-%m-%d 23:59:59') >= created_date
            </if>
            <if test="enterStatus != null "> and enter_status = #{enterStatus}</if>
            <if test="businessType != null "> and businessType = #{businessType}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="queryCondition != null  and queryCondition != ''">
             and ( carrier_name like concat('%', #{queryCondition}, '%')
             or checker_name like concat('%', #{queryCondition}, '%')
             or application_no like concat('%', #{queryCondition}, '%')
             or IDCard like concat('%', #{queryCondition}, '%')
             or car_number like concat('%', #{queryCondition}, '%')
             or driver_name like concat('%', #{queryCondition}, '%')
             or order_id like concat('%', #{queryCondition}, '%')
             )
             </if>
             <if test="checkerId!=null">
                 and (checker_id = #{checkerId} or created_by = #{checkerId})
             </if>
            <if test="carrierId!=null">
                 and carrier_id = #{carrierId}
             </if>
             order by created_date desc
        </where>
    </select>

